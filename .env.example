# Base path the site is served from.
# Use "/" for local development and custom domains, "/<repository-name>/" for GitHub Pages project sites.
VITE_BASE_PATH=/

# Public address of the deployed site, without a trailing slash and including the base path.
# It is used for canonical links, hreflang alternates, Open Graph tags and the sitemap.
# Leave it empty locally; those tags are simply left out.
# Example: https://your-user.github.io/my-portfolio-web
VITE_SITE_URL=
